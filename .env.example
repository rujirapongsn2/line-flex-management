# SQLite — path is relative to prisma/schema.prisma for CLI; use absolute in Docker.
# Local (from repo root):
DATABASE_URL="file:../data/linedev.db"

# Docker Compose sets:
# DATABASE_URL=file:/app/data/linedev.db

# Required in production — generate once: openssl rand -base64 32
LINEDEV_SESSION_SECRET=

# Only for first seed when no User and no data/auth.json
# INITIAL_ADMIN_PASSWORD=

# Public base URL (Flex / LIFF links)
PUBLIC_BASE_URL=https://your-domain.example

# LINE LIFF App ID (LINE Developers → LIFF → Endpoint URL = {PUBLIC_BASE_URL}/liff/checkin)
LIFF_ID=

# Longdo Map API key (server-side POI search — never expose to browser)
LONGDO_API_KEY=

# Optional: default Longdo tags CSV when user intent has no specific tag
# LONGDO_DEFAULT_TAGS=hospital,7-11,condominium,department_store

# Optional shared secret for /api/poi/search and /api/checkin (header x-poi-secret)
# POI_SHARED_SECRET=
# CHECKIN_SHARED_SECRET=

# Location Action (mode=http secrets referenced as {{secret:ENV_NAME}})
# Example: MY_POI_API_TOKEN=... then header Authorization: Bearer {{secret:MY_POI_API_TOKEN}}
# Default mode is longdo_poi (configure in console LINE page / LineConfig.locationAction JSON)
