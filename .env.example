# SQLite — path is relative to prisma/schema.prisma for CLI; use absolute in Docker.
# Local (from repo root):
DATABASE_URL="file:../data/linedev.db"

# Docker Compose sets:
# DATABASE_URL=file:/app/data/linedev.db

# Required in production — generate once: openssl rand -base64 32
LINEDEV_SESSION_SECRET=

# Only for first seed when no User and no data/auth.json
# INITIAL_ADMIN_PASSWORD=
