{
  "name": "linedev",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-db-url.cjs prisma generate && node scripts/with-db-url.cjs prisma db push && node scripts/with-db-url.cjs next dev -H 0.0.0.0 -p 3456",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3456",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "node scripts/with-db-url.cjs prisma db push",
    "db:studio": "node scripts/with-db-url.cjs prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.15.0",
    "typescript": "^5.9.2"
  }
}
